{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.example.com/schemas/v1/catalog-item.schema.json",
  "title": "CatalogItem",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[0-9]{4}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vendor": {
      "type": "object",
      "properties": {
        "vendorId": {
          "type": "string",
          "pattern": "^VND-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "contactEmail": {
          "type": "string",
          "format": "email"
        }
      },
      "required": ["vendorId", "name", "contactEmail"],
      "additionalProperties": false
    }
  },
  "required": ["sku", "name", "price", "tags", "vendor"],
  "additionalProperties": false
}